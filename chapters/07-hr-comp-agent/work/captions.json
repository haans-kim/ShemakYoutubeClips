[
 {
  "text": "오늘은 Shemak이 제공하는 기본급 인상률 시뮬레이션에 대해서 말씀을",
  "start": 1.2200000286102295,
  "end": 7.679999828338623
 },
 {
  "text": "드리고자 합니다",
  "start": 7.679999828338623,
  "end": 8.979999542236328
 },
 {
  "text": "저희가 접근하는 방식은 첫 번째로는 저희 의식 설문조사도",
  "start": 10.260000228881836,
  "end": 15.119999885559082
 },
 {
  "text": "기본급 인상을 할 때 큰 도움이 된다라는 특징을",
  "start": 15.119999885559082,
  "end": 20.639999389648438
 },
 {
  "text": "갖고 있습니다",
  "start": 20.639999389648438,
  "end": 21.15999984741211
 },
 {
  "text": "지금 보시는 것처럼 설문 결과를 패턴화 했더니 여러가지",
  "start": 21.360000610351562,
  "end": 25.600000381469727
 },
 {
  "text": "유형이 나온다고 지난번에 말씀드린 바가 있는데요",
  "start": 25.600000381469727,
  "end": 27.84000015258789
 },
 {
  "text": "이 패턴별로",
  "start": 27.84000015258789,
  "end": 29.540000915527344
 },
 {
  "text": "평가 등급별로",
  "start": 30.079999923706055,
  "end": 31.420000076293945
 },
 {
  "text": "그분들이 갖고 있는 시장 보상 수준에 대한 퍼센타일을",
  "start": 32.02000045776367,
  "end": 37.5
 },
 {
  "text": "종합적으로 고려를 해서 개인의 인근 조정률을 결정할 수",
  "start": 37.5,
  "end": 41.720001220703125
 },
 {
  "text": "있다 더하기 이 스킬이 진짜 중요한 스킬이라면 그분이",
  "start": 41.720001220703125,
  "end": 47.099998474121094
 },
 {
  "text": "보유한 스킬이 중요한 스킬이라면 혹은 다른 스킬이라면 어떻게",
  "start": 47.099998474121094,
  "end": 51.2400016784668
 },
 {
  "text": "인상률을 적용할 것인가를 시뮬레이션 할 수 있는 도구를",
  "start": 51.2400016784668,
  "end": 55.119998931884766
 },
 {
  "text": "Shemak은 제공합니다",
  "start": 55.119998931884766,
  "end": 56.040000915527344
 },
 {
  "text": "지금 보시는 것처럼 첫 번째로는 서베이 결과가 몇",
  "start": 56.040000915527344,
  "end": 59.79999923706055
 },
 {
  "text": "가지 유형으로 나뉘고요",
  "start": 59.79999923706055,
  "end": 61.36000061035156
 },
 {
  "text": "다음 지금 보시는 화면처럼 첫 번째 결정해야 될",
  "start": 61.97999954223633,
  "end": 66.44000244140625
 },
 {
  "text": "것은 임금정책이죠",
  "start": 66.44000244140625,
  "end": 68.19999694824219
 },
 {
  "text": "페이팔러시를 결정해야 되는데 남들만큼 줄 거냐 더 많이",
  "start": 69.37999725341797,
  "end": 72.9000015258789
 },
 {
  "text": "줄 거냐 아니면 기본급은 좀 낮춰서 가져갈 것인가에",
  "start": 72.9000015258789,
  "end": 76.66000366210938
 },
 {
  "text": "대한 의사결정을 하게 됩니다",
  "start": 76.66000366210938,
  "end": 78.16000366210938
 },
 {
  "text": "이 의사결정도 전사 공통이 될 수가 있고 설문",
  "start": 78.16000366210938,
  "end": 82.55999755859375
 },
 {
  "text": "결과 인력 유형이 될 수가 있고요",
  "start": 82.55999755859375,
  "end": 84.45999908447266
 },
 {
  "text": "직무 평가 결과 직무 가치가 높은 사람과 낮은",
  "start": 85.19999694824219,
  "end": 88.62000274658203
 },
 {
  "text": "사람에 대한 대응도 될 수가 있고 직책 여부에",
  "start": 88.62000274658203,
  "end": 91.54000091552734
 },
 {
  "text": "따라서 이 전략은 다르게 적용이 가능합니다",
  "start": 91.54000091552734,
  "end": 94.0
 },
 {
  "text": "이러면 제가 지금 말씀드린 모든 옵션들을 시뮬레이션 할",
  "start": 94.44000244140625,
  "end": 98.91999816894531
 },
 {
  "text": "수 있다",
  "start": 98.91999816894531,
  "end": 99.23999786376953
 },
 {
  "text": "그래서 지금 보시는 화면처럼 모든 내용을 다 넣습니다",
  "start": 99.55999755859375,
  "end": 103.77999877929688
 },
 {
  "text": "즉 전제는 왼쪽 위에 보시는 것처럼 인상 재원은",
  "start": 103.77999877929688,
  "end": 108.08000183105469
 },
 {
  "text": "통제합니다 총액이 예를 들면 3 5 고 약",
  "start": 108.08000183105469,
  "end": 111.58000183105469
 },
 {
  "text": "3억 정도가 주어진 기본급 인상 재원이다",
  "start": 111.58000183105469,
  "end": 114.5199966430664
 },
 {
  "text": "그렇게 한다면 평가 등급이 몇 개인가가 첫 번째",
  "start": 115.08000183105469,
  "end": 117.83999633789062
 },
 {
  "text": "함수인 것처럼 보이고요",
  "start": 117.83999633789062,
  "end": 119.0199966430664
 },
 {
  "text": "보상 전략의 몇 퍼센타일을 지향해야 되는가가 중요하게 됩니다",
  "start": 119.72000122070312,
  "end": 123.26000213623047
 },
 {
  "text": "그러고 나게 되면 고성과자와 설문조사 결과 그 사람이",
  "start": 123.26000213623047,
  "end": 129.05999755859375
 },
 {
  "text": "갖고 있는 의식의 패턴이 어떠한 패턴인가",
  "start": 129.05999755859375,
  "end": 132.33999633789062
 },
 {
  "text": "고모래평인가 아니면 저모래평인가 혹은 조용한 사직 유형인가에 따라서",
  "start": 132.83999633789062,
  "end": 137.75999450683594
 },
 {
  "text": "저희가 다르게 대응해야 된다는 거죠",
  "start": 137.75999450683594,
  "end": 139.47999572753906
 },
 {
  "text": "그리고 모든 시뮬레이션을 한 다음에 개별적으로 직군이나 이",
  "start": 139.47999572753906,
  "end": 145.24000549316406
 },
 {
  "text": "사람들이 갖고 있는 직군이나 이 사람이 갖고 있는",
  "start": 145.24000549316406,
  "end": 148.5800018310547
 },
 {
  "text": "스킬 혹은 직무의 속성을 따라서 외부의 오픈마켓에 있는",
  "start": 148.5800018310547,
  "end": 153.9199981689453
 },
 {
  "text": "소스들을 임금 소스들을 잘 긁어와서 크롤링해서 여기다",
  "start": 153.9199981689453,
  "end": 159.86000061035156
 },
 {
  "text": "부어넣습니다 그러고 나면 AI가 예측해주는 알고리즘을 저희 쉐막은",
  "start": 159.86000061035156,
  "end": 165.44000244140625
 },
 {
  "text": "내부에 장착되어 있는 상황입니다",
  "start": 165.44000244140625,
  "end": 167.27999877929688
 },
 {
  "text": "그래서 기본적으로 여러 가지 레버들 혹은 시뮬레이션 할",
  "start": 167.27999877929688,
  "end": 172.16000366210938
 },
 {
  "text": "수 있는 여러 가지 변수들만 움직이게 되면 누구한테",
  "start": 172.16000366210938,
  "end": 176.24000549316406
 },
 {
  "text": "얼마를 주는 게 최적인가가 초안을 작성하게 됩니다",
  "start": 176.24000549316406,
  "end": 179.66000366210938
 },
 {
  "text": "이거는 직원이 100명이든 직원이 1만 명이든 금방 시뮬레이션",
  "start": 180.39999389648438,
  "end": 185.24000549316406
 },
 {
  "text": "결과를 보여드릴 수가 있습니다",
  "start": 185.24000549316406,
  "end": 187.3000030517578
 },
 {
  "text": "그럴 경우에 전체의 인건비가 통제된 하에서 전체 구성원",
  "start": 187.3000030517578,
  "end": 193.13999938964844
 },
 {
  "text": "중에 직급별 인력의 유형별 혹은 그 사람의 평가",
  "start": 193.13999938964844,
  "end": 197.27999877929688
 },
 {
  "text": "등급별 임금 인상률 기본급 인상률이 얼마가 되어야 되는가가",
  "start": 197.27999877929688,
  "end": 202.66000366210938
 },
 {
  "text": "쉐막에 제공하는 가장 중요한 기능 중에 하나라고 생각하고",
  "start": 202.66000366210938,
  "end": 208.5399932861328
 },
 {
  "text": "있습니다 이걸 저희는 HR 에이전트라고 부르고 있고 HR",
  "start": 208.5399932861328,
  "end": 212.75999450683594
 },
 {
  "text": "헤드 혹은 어떤 HR 실제로 운영하고 있는 전문가들이",
  "start": 212.75999450683594,
  "end": 216.8000030517578
 },
 {
  "text": "반드시 사용하면 전략적으로 의사결정할 때 충분히 여러분을 도와드릴",
  "start": 216.8000030517578,
  "end": 222.60000610351562
 },
 {
  "text": "수 있는 기능이라고 저희는 강력히 추천드리고 싶습니다",
  "start": 222.60000610351562,
  "end": 226.05999755859375
 },
 {
  "text": "감사합니다",
  "start": 226.9199981689453,
  "end": 227.1199951171875
 }
]