[
 {
  "text": "좋은 날 되시기를 바랍니다",
  "start": 0.8399999737739563,
  "end": 2.940000057220459
 },
 {
  "text": "이번 시간에는 우리가 일하는 게 적정한가 저 부서는",
  "start": 3.4200000762939453,
  "end": 8.5
 },
 {
  "text": "왜 바쁜가 저 사람은 얼마나 바쁜가를 추정해 나가는",
  "start": 8.5,
  "end": 12.420000076293945
 },
 {
  "text": "AI Shemak을 보여드리려고 합니다",
  "start": 13.0,
  "end": 15.619999885559082
 },
 {
  "text": "지금 보시는 화면이",
  "start": 16.719999313354492,
  "end": 17.799999237060547
 },
 {
  "text": "큰 기업의 위에 횡으로 보여주는 조직이 임원 조직이고요",
  "start": 18.739999771118164,
  "end": 23.600000381469727
 },
 {
  "text": "오른쪽에 보이는 왼쪽에 보이는 레벨이 직급이라고 보시면 됩니다",
  "start": 23.8799991607666,
  "end": 27.940000534057617
 },
 {
  "text": "색깔이 빨갛게 보이는 영역은",
  "start": 28.520000457763672,
  "end": 30.639999389648438
 },
 {
  "text": "지금 무척 바쁜 조직이라고 보시면 되고요",
  "start": 31.34000015258789,
  "end": 33.779998779296875
 },
 {
  "text": "파랗게 보이는 조직은 비교적 여유가 있는 조직이다",
  "start": 34.34000015258789,
  "end": 38.02000045776367
 },
 {
  "text": "초록색은 적정하다라고 판단하고 있는 내용입니다",
  "start": 38.400001525878906,
  "end": 41.560001373291016
 },
 {
  "text": "여기 보시게 되면 근태시간이라는 게 존재합니다",
  "start": 42.36000061035156,
  "end": 46.08000183105469
 },
 {
  "text": "근태시간은 구성원들이 출근해서 퇴근할 때까지의",
  "start": 46.619998931884766,
  "end": 49.63999938964844
 },
 {
  "text": "법적인 휴게시간을 포함한 근태시간을 의미하고요",
  "start": 50.220001220703125,
  "end": 53.15999984741211
 },
 {
  "text": "저희가 초점을 맞추고 빨간색 파란색",
  "start": 53.720001220703125,
  "end": 56.2599983215332
 },
 {
  "text": "초록색을 보이게 되는 것은 주간 근무 추정 시간을",
  "start": 57.18000030517578,
  "end": 60.91999816894531
 },
 {
  "text": "근거로 합니다",
  "start": 60.91999816894531,
  "end": 61.65999984741211
 },
 {
  "text": "주간 근무 추정 시간이라고 하는 것은 야근을 하더라도",
  "start": 62.400001525878906,
  "end": 65.5999984741211
 },
 {
  "text": "실제로 안 바쁠 수도 있고요",
  "start": 65.5999984741211,
  "end": 67.22000122070312
 },
 {
  "text": "정시 출근",
  "start": 67.80000305175781,
  "end": 68.30000305175781
 },
 {
  "text": "정시 퇴근하더라도 무척 바쁜 사람도 있다고 가정하고 있습니다",
  "start": 68.81999969482422,
  "end": 72.73999786376953
 },
 {
  "text": "그러면 그걸 어떻게 추정할 것인가가 진정 어려운 과제가",
  "start": 73.55999755859375,
  "end": 77.0199966430664
 },
 {
  "text": "되겠죠 똑같이 한 사람이 같은 시간대에 같은 장소에",
  "start": 77.0199966430664,
  "end": 81.5199966430664
 },
 {
  "text": "앉아있는데 누구는 일을 바쁘게 하고 있고 누구는 여유가",
  "start": 81.5199966430664,
  "end": 84.36000061035156
 },
 {
  "text": "있다는 걸 추정해 나가는 게 무척 어려운 작업입니다",
  "start": 84.36000061035156,
  "end": 87.62000274658203
 },
 {
  "text": "이거는 저희는 지금 보시는 화면처럼",
  "start": 87.91999816894531,
  "end": 91.12000274658203
 },
 {
  "text": "조직이 갖고 있는 여러 가지 데이터들이 있습니다",
  "start": 92.54000091552734,
  "end": 96.04000091552734
 },
 {
  "text": "데이터들을 분석을 해서 개인들이 수행하고 있는 일이 혹은",
  "start": 96.9800033569336,
  "end": 101.68000030517578
 },
 {
  "text": "액티버트들이 이게 이 데이터 값과 연결되어지면 이 사람이",
  "start": 101.68000030517578,
  "end": 105.58000183105469
 },
 {
  "text": "지금 일하고 있다",
  "start": 105.58000183105469,
  "end": 106.5199966430664
 },
 {
  "text": "아니면 지금 일을 하고 있지 않다라는 판단하게 됩니다",
  "start": 106.86000061035156,
  "end": 109.9800033569336
 },
 {
  "text": "이때 첫 번째로는 500명이 있거나 300명이 있거나 1000명이",
  "start": 110.9800033569336,
  "end": 114.81999969482422
 },
 {
  "text": "있을 경우에 패턴을 분류하는 방식을 취합니다",
  "start": 114.81999969482422,
  "end": 117.44000244140625
 },
 {
  "text": "즉 외부에서 활동을 많이 하는 영업직원 같은 경우에",
  "start": 117.91999816894531,
  "end": 122.37999725341797
 },
 {
  "text": "보여주는 패턴",
  "start": 122.37999725341797,
  "end": 123.22000122070312
 },
 {
  "text": "연구소처럼 장비라든지 혼자 생각을 많이 하고 시간이 많이",
  "start": 124.58000183105469,
  "end": 128.4199981689453
 },
 {
  "text": "있는 패턴 등 패턴이 무척 다릅니다",
  "start": 128.4199981689453,
  "end": 130.82000732421875
 },
 {
  "text": "그러면 똑같은 액티버트나 똑같은 데이터가 오더라도 이걸 해석할",
  "start": 131.17999267578125,
  "end": 135.0399932861328
 },
 {
  "text": "때 똑같은 모니터를 주시하는 행위 자체가 어떤 사람한테는",
  "start": 135.0399932861328,
  "end": 140.05999755859375
 },
 {
  "text": "근무하고 있다고 판단이 되어지고요",
  "start": 140.05999755859375,
  "end": 141.52000427246094
 },
 {
  "text": "어떤 분은 근무하고 있지 않다라고 판단하는 패턴을 인식하게",
  "start": 141.8800048828125,
  "end": 145.10000610351562
 },
 {
  "text": "됩니다 이 데이터를 일간 단위 데이터로 받아올 수",
  "start": 145.10000610351562,
  "end": 149.94000244140625
 },
 {
  "text": "있는 게 있고요",
  "start": 149.94000244140625,
  "end": 150.6199951171875
 },
 {
  "text": "주간 단위로 받아올 수 있는 게 있고 월간",
  "start": 150.9199981689453,
  "end": 153.6199951171875
 },
 {
  "text": "단위로 다운로드 받을 수 있는 데이터가 있습니다",
  "start": 153.6199951171875,
  "end": 155.44000244140625
 },
 {
  "text": "이거를 모델링을 합니다",
  "start": 155.60000610351562,
  "end": 157.0399932861328
 },
 {
  "text": "개인별로 모델링도 가능하고 기능별로 모델링도 가능합니다",
  "start": 158.10000610351562,
  "end": 161.75999450683594
 },
 {
  "text": "이거를 지금 보시는 화면처럼 주간 단위로 월간 단위로",
  "start": 162.0,
  "end": 165.6999969482422
 },
 {
  "text": "모델링한 게 최종적으로 보여주는 데시보드의 역할을 보시면 됩니다",
  "start": 166.9600067138672,
  "end": 171.6199951171875
 },
 {
  "text": "그러면 이 데시보드에 빨간색이 나올 경우에는 두 가지",
  "start": 172.07000732421875,
  "end": 175.94000244140625
 },
 {
  "text": "이유가 있을 것처럼 보입니다",
  "start": 175.94000244140625,
  "end": 177.05999755859375
 },
 {
  "text": "하나는 진짜 업무량이 많다",
  "start": 177.39999389648438,
  "end": 179.52000427246094
 },
 {
  "text": "지난 시간에 보여드렸던 근무 인력 동인이 너무 많아서",
  "start": 180.02000427246094,
  "end": 184.39999389648438
 },
 {
  "text": "바쁠 수가 있고요",
  "start": 184.39999389648438,
  "end": 185.25999450683594
 },
 {
  "text": "두 번째로는 일을 하고 있는 사람 구성원의 스킬세트가",
  "start": 185.60000610351562,
  "end": 190.1999969482422
 },
 {
  "text": "부서나 기능을 요구하고 있는 스킬세트와 맞지 않을 경우에",
  "start": 190.67999267578125,
  "end": 194.8000030517578
 },
 {
  "text": "빨간색이 될 수가 있습니다",
  "start": 194.8000030517578,
  "end": 195.89999389648438
 },
 {
  "text": "파란색도 반대로 해석하면 됩니다",
  "start": 197.5800018310547,
  "end": 199.44000244140625
 },
 {
  "text": "인력 동인이 혹시 적거나 즉 업무의 부하가 적거나",
  "start": 200.0800018310547,
  "end": 204.83999633789062
 },
 {
  "text": "두 번째로는 스킬세트가 너무 잘 맞아서 혹은 스킬에",
  "start": 204.83999633789062,
  "end": 209.32000732421875
 },
 {
  "text": "대한 숙련도가 무척 높아서 일을 빨리 끝낼 수도",
  "start": 209.32000732421875,
  "end": 212.6999969482422
 },
 {
  "text": "있는 거죠",
  "start": 212.6999969482422,
  "end": 213.24000549316406
 },
 {
  "text": "이 첫 번째 보여드렸던 적정 인력 관련된 인력",
  "start": 213.66000366210938,
  "end": 218.83999633789062
 },
 {
  "text": "동인 방식과 다음",
  "start": 218.86000061035156,
  "end": 220.33999633789062
 },
 {
  "text": "시간에 설명드릴 구성원의 개인 스킬을 종합적으로 판단해야",
  "start": 220.33999633789062,
  "end": 224.72000122070312
 },
 {
  "text": "빨간색이냐 초록색이냐",
  "start": 225.4199981689453,
  "end": 227.9600067138672
 },
 {
  "text": "파란색이냐가 완밀히 해석할 수 있을 것처럼 보입니다",
  "start": 228.5800018310547,
  "end": 232.89999389648438
 },
 {
  "text": "그래서 이 대시보드를 매월 누적시키면서",
  "start": 233.5,
  "end": 236.50999450683594
 },
 {
  "text": "다음 달은 어떻게 될 것인가를 예측해나가는 작업",
  "start": 236.9600067138672,
  "end": 240.22000122070312
 },
 {
  "text": "이게 쉐막이 도와드릴 수 있는 영역이라고 생각합니다",
  "start": 240.67999267578125,
  "end": 243.44000244140625
 },
 {
  "text": "감사합니다",
  "start": 244.16000366210938,
  "end": 244.39999389648438
 }
]