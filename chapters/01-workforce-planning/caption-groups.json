[
 {
  "text": "좋은 하루 되시길 빕니다 오늘",
  "start": 0.0,
  "end": 4.519999980926514
 },
 {
  "text": "시간에는 정원 산정 흔히 적정",
  "start": 4.519999980926514,
  "end": 6.579999923706055
 },
 {
  "text": "인력 관련된 이야기를 기존에 했던",
  "start": 6.579999923706055,
  "end": 9.619999885559082
 },
 {
  "text": "재래식 방식이 어떻게 굴러 갔는지",
  "start": 9.619999885559082,
  "end": 12.300000190734863
 },
 {
  "text": "다음에 ai hr을 도입한 쇠",
  "start": 12.300000190734863,
  "end": 16.3799991607666
 },
 {
  "text": "막을 가지고 도입하면 어떤 모양을",
  "start": 16.3799991607666,
  "end": 18.100000381469727
 },
 {
  "text": "지내게 되는지를 나누어서 설명 드리고자",
  "start": 18.100000381469727,
  "end": 21.200000762939453
 },
 {
  "text": "합니다 지금 보시는 화면이 전형적으로",
  "start": 21.200000762939453,
  "end": 24.420000076293945
 },
 {
  "text": "저희가 레거시 방식으로 했던 인력",
  "start": 24.420000076293945,
  "end": 26.940000534057617
 },
 {
  "text": "산정 방식입니다 첫 번째로는 모든",
  "start": 26.940000534057617,
  "end": 30.31999969482422
 },
 {
  "text": "구성원들한테 혹은 모든 조직한테 양식을",
  "start": 30.31999969482422,
  "end": 33.79999923706055
 },
 {
  "text": "나누 드려서 인력 동인이 무엇인가",
  "start": 33.79999923706055,
  "end": 36.52000045776367
 },
 {
  "text": "그리고 최근 3년간 혹은 1년간",
  "start": 36.52000045776367,
  "end": 39.18000030517578
 },
 {
  "text": "이 인력 동인 이 어떠한",
  "start": 39.18000030517578,
  "end": 41.47999954223633
 },
 {
  "text": "값을 보였는가와 몇 시간을 투입했는가를",
  "start": 41.47999954223633,
  "end": 44.15999984741211
 },
 {
  "text": "다 작성하게 합니다 두 번째로는",
  "start": 44.15999984741211,
  "end": 47.119998931884766
 },
 {
  "text": "이게 실제 업무량과 어떻게 되는지를",
  "start": 47.119998931884766,
  "end": 49.5
 },
 {
  "text": "분석하는 업무량 진단이 이루어지게 되고요",
  "start": 49.5,
  "end": 52.2599983215332
 },
 {
  "text": "세 번째로는 그 당시에 썼던",
  "start": 52.2599983215332,
  "end": 54.779998779296875
 },
 {
  "text": "비용 그리고 향후에 우리가 지불",
  "start": 54.779998779296875,
  "end": 56.900001525878906
 },
 {
  "text": "가능한 인건비 영업이익 대비 인건비율",
  "start": 56.900001525878906,
  "end": 59.97999954223633
 },
 {
  "text": "등등을 정한 다음에 최종적으로 는",
  "start": 59.97999954223633,
  "end": 62.91999816894531
 },
 {
  "text": "적정한 인력 안이 어떻다를 산출",
  "start": 62.91999816894531,
  "end": 65.77999877929688
 },
 {
  "text": "해 나가는 구조를 지니게 됩니다",
  "start": 65.77999877929688,
  "end": 67.0999984741211
 },
 {
  "text": "그 결과 지금 두 번째",
  "start": 67.87999725341797,
  "end": 68.9000015258789
 },
 {
  "text": "화면에 보시는 것처럼 각 조직별로",
  "start": 68.9000015258789,
  "end": 71.9800033569336
 },
 {
  "text": "혹은 파트별로 기능별로 현재 인원과",
  "start": 71.9800033569336,
  "end": 75.45999908447266
 },
 {
  "text": "향후에 필요한 인원 그다음에 업무량의",
  "start": 75.45999908447266,
  "end": 78.05999755859375
 },
 {
  "text": "증강 요소들을 종합적으로 고려해서 인력이",
  "start": 78.05999755859375,
  "end": 81.80000305175781
 },
 {
  "text": "향후에 몇 명이 필요하겠구나라는 머티리얼을",
  "start": 81.80000305175781,
  "end": 84.30000305175781
 },
 {
  "text": "만들어서 보고하게 되는 구조입니다 전형적으로",
  "start": 84.30000305175781,
  "end": 87.04000091552734
 },
 {
  "text": "특정 시점에 한 번의 조사를",
  "start": 87.04000091552734,
  "end": 89.31999969482422
 },
 {
  "text": "통해서 다음 필요한 시기의 인력이",
  "start": 89.31999969482422,
  "end": 93.0
 },
 {
  "text": "얼마나 소요되는가를 예측 해 나가는",
  "start": 93.0,
  "end": 94.80000305175781
 },
 {
  "text": "방식이라고 본다면 지금 보시는 화면은",
  "start": 94.80000305175781,
  "end": 99.83999633789062
 },
 {
  "text": "각 조직별로 직급 별로 매월",
  "start": 99.83999633789062,
  "end": 103.12000274658203
 },
 {
  "text": "혹은 특정 연도의 다음 분기에",
  "start": 103.12000274658203,
  "end": 105.54000091552734
 },
 {
  "text": "몇 명이 필요한가를 예측 해",
  "start": 105.54000091552734,
  "end": 107.23999786376953
 },
 {
  "text": "나가는 방식입니다 먼저 지금 보시는",
  "start": 107.23999786376953,
  "end": 110.5199966430664
 },
 {
  "text": "화면은 전사의 인력들이 과거의 전사인력들이",
  "start": 110.5199966430664,
  "end": 116.33999633789062
 },
 {
  "text": "변수별로 인력 동인입니다 인력 동인별로",
  "start": 116.33999633789062,
  "end": 119.63999938964844
 },
 {
  "text": "전사인력의 어떠한 회귀관계를 보여주는가를 설명",
  "start": 119.63999938964844,
  "end": 124.16000366210938
 },
 {
  "text": "하게 되고요 이게 각 부서별로도",
  "start": 124.16000366210938,
  "end": 126.5999984741211
 },
 {
  "text": "다시 한 번 브레이크 다운되게",
  "start": 126.5999984741211,
  "end": 127.77999877929688
 },
 {
  "text": "됩니다 그래서 특정한 부서에 예를",
  "start": 127.77999877929688,
  "end": 130.9199981689453
 },
 {
  "text": "들면 지금 보시는 화면처럼 특정한",
  "start": 130.9199981689453,
  "end": 133.66000366210938
 },
 {
  "text": "부서 의 특정팀의 인력 동인을",
  "start": 133.66000366210938,
  "end": 137.0399932861328
 },
 {
  "text": "현재 업무 매뉴얼이라든지 현재 쓰고",
  "start": 137.0399932861328,
  "end": 141.47999572753906
 },
 {
  "text": "있는 구성원들의 인터뷰 결과들 토대로",
  "start": 141.47999572753906,
  "end": 145.6999969482422
 },
 {
  "text": "인력 동인들 피처값을 찾아 냅니다",
  "start": 145.6999969482422,
  "end": 149.52000427246094
 },
 {
  "text": "그리고 과거 데이터 3년치를 모아서",
  "start": 150.05999755859375,
  "end": 152.6999969482422
 },
 {
  "text": "회귀관계를 찾아 냅니다 또 하나는",
  "start": 152.6999969482422,
  "end": 156.55999755859375
 },
 {
  "text": "이게 부서 내에 있는 값",
  "start": 156.55999755859375,
  "end": 158.94000244140625
 },
 {
  "text": "뿐만이 아니고요 이 부서와 전후에",
  "start": 158.94000244140625,
  "end": 162.94000244140625
 },
 {
  "text": "있는 부서들의 지표 간의 연관관계도",
  "start": 162.94000244140625,
  "end": 165.60000610351562
 },
 {
  "text": "동시에 ai가 일종의 알고리즘을 발굴해서",
  "start": 165.60000610351562,
  "end": 169.55999755859375
 },
 {
  "text": "예측 하게 됩니다 이때 대부분",
  "start": 169.55999755859375,
  "end": 172.17999267578125
 },
 {
  "text": "결측치가 무척 문제가 되게 됩니다",
  "start": 172.17999267578125,
  "end": 174.6999969482422
 },
 {
  "text": "즉 모든 프로세스나 지표별로 완벽히",
  "start": 175.86000061035156,
  "end": 178.05999755859375
 },
 {
  "text": "데이터가 다 있어야 되는데 그게",
  "start": 178.05999755859375,
  "end": 180.02000427246094
 },
 {
  "text": "다 모자라게 되는 상황이 많이",
  "start": 180.02000427246094,
  "end": 181.66000366210938
 },
 {
  "text": "발생 하게 되는 거죠 그래서",
  "start": 181.66000366210938,
  "end": 183.39999389648438
 },
 {
  "text": "쉐막은 모자란 부분 즉 결측치를",
  "start": 183.39999389648438,
  "end": 187.89999389648438
 },
 {
  "text": "정확히 예측해서 좀 더 설명",
  "start": 187.89999389648438,
  "end": 190.6999969482422
 },
 {
  "text": "가능성을 높여주는데 초점을 맞추고 있다고",
  "start": 190.6999969482422,
  "end": 193.1199951171875
 },
 {
  "text": "보시면 됩니다 그 결과 지금",
  "start": 193.1199951171875,
  "end": 195.0399932861328
 },
 {
  "text": "보시는 화면처럼 특정한 팀은 지표가",
  "start": 195.0399932861328,
  "end": 200.24000549316406
 },
 {
  "text": "지금 보시는 화면처럼 움직일 경우에",
  "start": 200.24000549316406,
  "end": 202.55999755859375
 },
 {
  "text": "인원이 어떻게 가운데 세 번째에",
  "start": 202.55999755859375,
  "end": 206.5
 },
 {
  "text": "있는 지표가 증가하게 되면 인력",
  "start": 206.5,
  "end": 208.60000610351562
 },
 {
  "text": "예측이 어떻게 바뀔 것인가를 다음",
  "start": 208.60000610351562,
  "end": 211.0
 },
 {
  "text": "달 혹은 다음 분기 내년에",
  "start": 211.0,
  "end": 212.94000244140625
 },
 {
  "text": "어떻게 될 것인가를 예측하게 됩니다",
  "start": 212.94000244140625,
  "end": 214.6999969482422
 },
 {
  "text": "이거를 전체적으로 종합을 하면 지금",
  "start": 215.4600067138672,
  "end": 217.97999572753906
 },
 {
  "text": "보신 화면처럼 내년도에는 전사가 몇",
  "start": 217.97999572753906,
  "end": 220.83999633789062
 },
 {
  "text": "명이 필요하겠구나 혹은 다음 분기에는",
  "start": 220.83999633789062,
  "end": 223.0800018310547
 },
 {
  "text": "다음 반기에는 혹은 특정한 요인들이",
  "start": 223.0800018310547,
  "end": 227.25999450683594
 },
 {
  "text": "인력 동행들이 변경되게 되면 몇",
  "start": 227.25999450683594,
  "end": 229.8800048828125
 },
 {
  "text": "명이 필요할까를 예측하게 됩니다 이게",
  "start": 229.8800048828125,
  "end": 232.60000610351562
 },
 {
  "text": "쉐막이 제공하는 기존의 재래식 방식과",
  "start": 232.60000610351562,
  "end": 235.3800048828125
 },
 {
  "text": "좀 다 차별화된 방법론 이라고",
  "start": 235.3800048828125,
  "end": 237.60000610351562
 },
 {
  "text": "설명을 드릴 수가 있겠습니다 감사합니다",
  "start": 237.60000610351562,
  "end": 239.72000122070312
 }
]