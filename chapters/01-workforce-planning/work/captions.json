[
 {
  "text": "좋은 하루 되시길 빕니다",
  "start": 0.0,
  "end": 3.4200000762939453
 },
 {
  "text": "오늘 시간에는 정원 산정 흔히 적정 인력 관련된",
  "start": 4.199999809265137,
  "end": 7.480000019073486
 },
 {
  "text": "이야기를 기존에 했던 재래식 방식이 어떻게 굴러 갔는지",
  "start": 7.480000019073486,
  "end": 12.300000190734863
 },
 {
  "text": "다음에 ai hr을 도입한 쉐막을 가지고 도입하면",
  "start": 12.300000190734863,
  "end": 17.440000534057617
 },
 {
  "text": "어떤 모양을 지내게 되는지를 나누어서 설명 드리고자 합니다",
  "start": 17.440000534057617,
  "end": 21.440000534057617
 },
 {
  "text": "지금 보시는 화면이 전형적으로 저희가 레거시 방식으로 했던",
  "start": 22.1200008392334,
  "end": 26.520000457763672
 },
 {
  "text": "인력 산정 방식입니다",
  "start": 26.520000457763672,
  "end": 28.059999465942383
 },
 {
  "text": "첫 번째로는 모든 구성원들한테 혹은 모든 조직한테 양식을",
  "start": 28.579999923706055,
  "end": 33.79999923706055
 },
 {
  "text": "나눠 드려서 인력 동인이 무엇인가 그리고 최근 3년간",
  "start": 33.79999923706055,
  "end": 37.939998626708984
 },
 {
  "text": "혹은 1년간 이 인력 동인 이 어떠한 값을",
  "start": 37.939998626708984,
  "end": 41.81999969482422
 },
 {
  "text": "보였는가와 몇 시간을 투입했는가를 다 작성하게 합니다",
  "start": 41.81999969482422,
  "end": 45.880001068115234
 },
 {
  "text": "두 번째로는 이게 실제 업무량과 어떻게 되는지를 분석하는",
  "start": 46.2599983215332,
  "end": 50.20000076293945
 },
 {
  "text": "업무량 진단이 이루어지게 되고요",
  "start": 50.20000076293945,
  "end": 52.2599983215332
 },
 {
  "text": "세 번째로는 그 당시에 썼던 비용 그리고 향후에",
  "start": 52.2599983215332,
  "end": 56.439998626708984
 },
 {
  "text": "우리가 지불 가능한 인건비 영업이익 대비 인건비율 등등을",
  "start": 56.439998626708984,
  "end": 60.47999954223633
 },
 {
  "text": "정한 다음에 최종적으로 는 적정한 인력 안이 어떻다를",
  "start": 60.47999954223633,
  "end": 65.0
 },
 {
  "text": "산출 해 나가는 구조를 지니게 됩니다",
  "start": 65.0,
  "end": 67.0999984741211
 },
 {
  "text": "그 결과 지금 두 번째 화면에 보시는 것처럼",
  "start": 67.87999725341797,
  "end": 70.27999877929688
 },
 {
  "text": "각 조직별로 혹은 파트별로 기능별로 현재 인원과 향후에",
  "start": 70.27999877929688,
  "end": 76.31999969482422
 },
 {
  "text": "필요한 인원 그다음에 업무량의 증강 요소 등을 종합적으로",
  "start": 76.31999969482422,
  "end": 79.54000091552734
 },
 {
  "text": "고려해서 인력이 향후에 몇 명이 필요하겠구나라는 마테리어를 만들어서",
  "start": 79.54000091552734,
  "end": 84.80000305175781
 },
 {
  "text": "보고하게 되는 구조입니다",
  "start": 84.80000305175781,
  "end": 85.9800033569336
 },
 {
  "text": "전형적으로 특정 시점에 한 번의 조사를 통해서 다음",
  "start": 86.55999755859375,
  "end": 90.91999816894531
 },
 {
  "text": "필요한 시기의 인력이 얼마나 소요되는가를 예측 해 나가는",
  "start": 90.91999816894531,
  "end": 94.80000305175781
 },
 {
  "text": "방식이라고 본다면 지금 보시는 화면은 각 조직별로 직급",
  "start": 94.80000305175781,
  "end": 101.62000274658203
 },
 {
  "text": "별로 매월 혹은 특정 연도의 다음",
  "start": 101.62000274658203,
  "end": 105.41000366210938
 },
 {
  "text": "시기에 몇 명이 필요한가를 예측 해 나가는 방식입니다",
  "start": 105.41000366210938,
  "end": 108.2699966430664
 },
 {
  "text": "먼저 지금 보시는 화면은 전사의 인력들이 과거의 전사인력들이",
  "start": 108.80999755859375,
  "end": 116.3499984741211
 },
 {
  "text": "변수별로 인력 동인입니다",
  "start": 116.3499984741211,
  "end": 118.12999725341797
 },
 {
  "text": "인력 동인별로 전사인력의 어떠한 회귀관계를 보여주는가를 설명 하게",
  "start": 118.2699966430664,
  "end": 124.44999694824219
 },
 {
  "text": "되고요 이게 각 부서별로도 다시 한 번 브레이크",
  "start": 124.44999694824219,
  "end": 127.37000274658203
 },
 {
  "text": "다운되게 됩니다",
  "start": 127.37000274658203,
  "end": 128.02999877929688
 },
 {
  "text": "그래서 특정한 부서에 예를 들면 지금 보시는 화면처럼",
  "start": 129.08999633789062,
  "end": 132.92999267578125
 },
 {
  "text": "특정한 부서 의 특정팀의 인력 동인을 현재 업무",
  "start": 132.92999267578125,
  "end": 139.42999267578125
 },
 {
  "text": "매뉴얼이라든지 현재 쓰고 있는 구성원들의 인터뷰 결과들 토대로",
  "start": 139.42999267578125,
  "end": 145.7100067138672
 },
 {
  "text": "인력 동인들 피처값을 찾아 냅니다",
  "start": 145.7100067138672,
  "end": 149.52999877929688
 },
 {
  "text": "그리고 그걸 과거 데이터 3년치를 모아서 회귀관계를 찾아",
  "start": 150.0500030517578,
  "end": 154.61000061035156
 },
 {
  "text": "냅니다 그리고 또 하나는 이게 부서 내에 있는",
  "start": 154.61000061035156,
  "end": 158.19000244140625
 },
 {
  "text": "깜뿐만이 아니고요",
  "start": 158.19000244140625,
  "end": 159.75
 },
 {
  "text": "이 부서와 전후에 있는 부서들의 지표 간의 연관관계도",
  "start": 159.75,
  "end": 165.58999633789062
 },
 {
  "text": "동시에 ai가 일종의 알고리즘을 발굴해서 예측 하게 됩니다",
  "start": 165.58999633789062,
  "end": 170.72999572753906
 },
 {
  "text": "이때 대부분 결측치가 무척 문제가 되게 됩니다",
  "start": 171.1699981689453,
  "end": 174.7100067138672
 },
 {
  "text": "즉 모든 프로세스나 지표별로 완벽히 데이터가 다 있어야",
  "start": 175.85000610351562,
  "end": 178.91000366210938
 },
 {
  "text": "되는데 그게 다 모자라게 되는 상황이 많이 발생",
  "start": 178.91000366210938,
  "end": 181.77000427246094
 },
 {
  "text": "하게 되는 거죠",
  "start": 181.77000427246094,
  "end": 182.4499969482422
 },
 {
  "text": "그래서 쉐막은 모자란 부분 즉 결측치를 정확히 예측해서",
  "start": 182.9499969482422,
  "end": 189.14999389648438
 },
 {
  "text": "좀 더 설명 가능성을 높여주는데 초점을 맞추고 있다고",
  "start": 189.14999389648438,
  "end": 193.1300048828125
 },
 {
  "text": "보시면 됩니다",
  "start": 193.1300048828125,
  "end": 193.8300018310547
 },
 {
  "text": "그 결과 지금 보시는 화면처럼 이 특정한 팀은",
  "start": 194.30999755859375,
  "end": 197.97000122070312
 },
 {
  "text": "지표가 지금 보시는 화면처럼 움직일 경우에 인원이 어떻게",
  "start": 197.97000122070312,
  "end": 205.11000061035156
 },
 {
  "text": "가운데 세 번째에 있는 지표가 증가 하게 되면",
  "start": 205.11000061035156,
  "end": 207.8699951171875
 },
 {
  "text": "인력 예측이 어떻게 바뀔 것인가를 다음",
  "start": 207.8699951171875,
  "end": 211.0500030517578
 },
 {
  "text": "달 혹은 다음",
  "start": 211.0500030517578,
  "end": 211.8300018310547
 },
 {
  "text": "분기 내년에 어떻게 될 것인가를 예측하게 됩니다",
  "start": 211.8300018310547,
  "end": 214.69000244140625
 },
 {
  "text": "이거를 전체적으로 종합을 하면 지금 보신 화면처럼 내년도에는",
  "start": 215.5500030517578,
  "end": 219.69000244140625
 },
 {
  "text": "전사가 몇 명이 필요하겠구나 혹은 다음",
  "start": 219.69000244140625,
  "end": 222.50999450683594
 },
 {
  "text": "분기에는 다음",
  "start": 222.50999450683594,
  "end": 223.85000610351562
 },
 {
  "text": "반기에는 혹은",
  "start": 223.85000610351562,
  "end": 224.97000122070312
 },
 {
  "text": "특정한 요인들이 인력 동인들이 변경되게 되면 몇 명이",
  "start": 225.99000549316406,
  "end": 230.1300048828125
 },
 {
  "text": "필요할까를 예측하게 됩니다",
  "start": 230.1300048828125,
  "end": 231.3300018310547
 },
 {
  "text": "이게 쉐막이 제공하는 기존의 재래식 방식과 좀 다",
  "start": 232.19000244140625,
  "end": 235.8300018310547
 },
 {
  "text": "차별화된 방법론 이라고 설명을 드릴 수가 있겠습니다",
  "start": 235.8300018310547,
  "end": 238.92999267578125
 },
 {
  "text": "감사합니다",
  "start": 239.47000122070312,
  "end": 239.75
 }
]